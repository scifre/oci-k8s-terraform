# Copy to terraform.tfvars and fill in your values.

# --- Provider authentication ---
tenancy_ocid     = "ocid1.tenancy.oc1..aaaaaaaaEXAMPLE"
user_ocid        = "ocid1.user.oc1..aaaaaaaaEXAMPLE"
fingerprint      = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
private_key_path = "~/.oci/oci_api_key.pem"
region           = "ap-mumbai-1"

# --- Placement ---
compartment_ocid = "ocid1.compartment.oc1..aaaaaaaaEXAMPLE"

# --- Cluster ---
kubernetes_version = "v1.36.1"
cluster_name       = "k8s-cluster-01"

# CIDRs allowed to reach the public API endpoint on TCP 6443.
# Leave empty to create no external access rule. Set to your admin IPs, e.g.:
# api_allowed_cidrs = ["203.0.113.10/32"]
api_allowed_cidrs = []

# --- Node pool ---
node_pool_name               = "k8s-free-np"
node_image_name              = "Oracle-Linux-8.10-aarch64-2026.08.14-0-OKE-1.36.1-1699"
node_shape                   = "VM.Standard.A1.Flex"
node_ocpus                   = 1
node_memory_in_gbs           = 6
node_boot_volume_size_in_gbs = 90
node_count                   = 2
node_eviction_grace_duration = "PT60M"

# --- IAM ---
# Keep false to use compartment-scoped minimal OKE service policy (recommended).
oke_policy_broad = false
