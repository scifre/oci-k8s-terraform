#############################################
# Terraform
#############################################

# Local .terraform directories (provider plugins, modules cache)
.terraform/

# Terraform state and backups (may contain secrets; use remote state instead)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Saved plan output (binary plans can contain sensitive values)
*.tfplan
tfplan
plan.txt
plan.out

# Variable files with real values (keep the .example committed)
*.tfvars
*.tfvars.json
!*.tfvars.example

# CLI config / override files
.terraformrc
terraform.rc
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# NOTE: .terraform.lock.hcl is intentionally NOT ignored — commit it so
# provider selections are reproducible.

#############################################
# OCI credentials / secrets
#############################################

.env
.env.*
*.pem
oci_api_key*
~/.oci
.oci/

#############################################
# Kubernetes (generated by scripts/install-addons.sh)
#############################################

kubeconfig
kubeconfig.*
*.kubeconfig

#############################################
# Editor / OS cruft
#############################################

.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/
